# Groq — https://console.groq.com/keys
GROQ_API_KEY=gsk_replace_me

# Model routing
GROQ_ROUTER_MODEL=openai/gpt-oss-20b
GROQ_ANSWER_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b
GROQ_STT_MODEL=whisper-large-v3

# Embeddings: Google Gemini (Groq has no embeddings endpoint).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=replace_me
EMBED_MODEL=gemini-embedding-001
# 1536, not the native 3072: pgvector HNSW indexes cap at 2000 dimensions.
EMBED_DIMENSIONS=1536

# Reranking uses a small Groq model (Gemini publishes no reranker).
RERANK_MODEL=openai/gpt-oss-20b

# Supabase (Postgres + pgvector), accessed over the REST API.
# Project Settings -> API. The service key is only needed for ingestion writes.
SUPABASE_URL=https://lnipowpeantcszcuxpxb.supabase.co
SUPABASE_KEY=replace_me_publishable_or_anon_key
SUPABASE_SERVICE_KEY=replace_me_service_role_key

# Local SQLite is kept only as the ingestion staging area.
DATABASE_URL=sqlite:///./data/bis.db

# Retrieval tuning
RETRIEVE_TOP_K=30
RERANK_TOP_K=6
RRF_K=60
MIN_EVIDENCE_SCORE=0.35

# Scraping etiquette
SCRAPE_DELAY_SECONDS=1.0
SCRAPE_USER_AGENT=bis-assistant/0.1 (SIH-26107 research prototype)
