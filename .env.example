# Groq — https://console.groq.com/keys
GROQ_API_KEY=gsk_replace_me

# Model routing
GROQ_ROUTER_MODEL=llama-3.1-8b-instant
GROQ_ANSWER_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3

# Local embedding + reranking (Groq has no embeddings API)
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
EMBED_DEVICE=cpu

# Stores
# ":local:" = embedded Qdrant under data/qdrant (no Docker needed, single-process).
# Point at http://localhost:6333 once you run docker compose up.
QDRANT_URL=:local:
QDRANT_COLLECTION=bis_chunks
DATABASE_URL=sqlite:///./data/bis.db

# Retrieval tuning
RETRIEVE_TOP_K=30
RERANK_TOP_K=6
RRF_K=60
MIN_EVIDENCE_SCORE=0.35

# Scraping etiquette
SCRAPE_DELAY_SECONDS=1.0
SCRAPE_USER_AGENT=bis-assistant/0.1 (SIH-26107 research prototype)
