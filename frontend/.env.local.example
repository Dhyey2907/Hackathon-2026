# Backend API. Leave unset to develop against fixtures instead.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Force fixtures even when a backend URL is configured.
# NEXT_PUBLIC_USE_MOCK=true

# Supabase — sign-in and chat history only. Publishable/anon key, never the
# service key: this value ships to the browser, and only row-level security
# keeps one user's chat history away from another's.
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Google Maps - the lab maps in the chat panel and on /labs. Optional.
# A browser key: it ships in the page, so in Google Cloud restrict it to your
# site (HTTP referrers, e.g. http://localhost:3000/*) and to two APIs: Maps
# JavaScript API and Places API (New). Restart `npm run dev` after editing.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
